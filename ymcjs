    <style>
        /* ===== 重新开始这一关嗯对 ===== */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: #1a1a1a;
            background-image: 
                linear-gradient(rgba(0,0,0,0.7), rgba(0,0,0,0.7)),
                repeating-linear-gradient(45deg, #2a2a2a 0px, #2a2a2a 2px, #222 2px, #222 4px);
            display: flex;
            justify-content: center;
            align-items: flex-start;
            min-height: 100vh;
            font-family: 'Courier New', 'Consolas', monospace;
            padding: 20px;
            color: #e0e0e0;
        }

        .container {
            max-width: 1000px;
            width: 100%;
        }

        /* ===== 顶部标题栏 ===== */
        .header-bar {
            background: #2d2d2d;
            border: 2px solid #4a4a4a;
            border-bottom: 4px solid #1a1a1a;
            padding: 15px 25px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            box-shadow: 0 4px 0 #0a0a0a;
        }

        .header-bar h1 {
            color: #fff;
            font-size: 32px;
            font-weight: bold;
            text-shadow: 3px 3px 0 #000;
            letter-spacing: 3px;
            font-family: 'Courier New', monospace;
            margin: 0;
        }

        .header-bar .menu-icon {
            color: #fff;
            font-size: 28px;
            cursor: pointer;
            text-shadow: 2px 2px 0 #000;
        }

        /* ===== 标签页导航 ===== */
        .tab-bar {
            display: flex;
            gap: 2px;
            margin-bottom: 20px;
        }

        .tab {
            background: #2d2d2d;
            border: 2px solid #4a4a4a;
            border-bottom: none;
            color: #aaa;
            padding: 8px 20px;
            font-size: 14px;
            font-weight: bold;
            cursor: default;
            font-family: 'Courier New', monospace;
        }

        .tab.active {
            background: #3a3a3a;
            color: #fff;
            border-color: #6a6a6a;
        }

        /* ===== 游戏窗口容器（Windows 风格窗口） ===== */
        .game-window {
            background: #1a1a1a;
            border: 3px solid #4a4a4a;
            border-bottom: 4px solid #1a1a1a;
            margin-bottom: 25px;
            position: relative;
            min-height: 300px;
            box-shadow: 6px 6px 0 #0a0a0a, inset 0 0 50px rgba(0,0,0,0.8);
            display: none;
        }

        /* 窗口标题栏 */
        .window-titlebar {
            background: #2d2d2d;
            border-bottom: 3px solid #1a1a1a;
            padding: 6px 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-family: 'Courier New', monospace;
            user-select: none;
        }

        .window-title {
            color: #fff;
            font-size: 14px;
            font-weight: bold;
            letter-spacing: 2px;
            text-shadow: 2px 2px 0 #000;
            padding-left: 4px;
        }

        .window-controls {
            display: flex;
            gap: 6px;
        }

        /* Windows 风格控制按钮 */
        .win-btn {
            width: 32px;
            height: 28px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #3a3a3a;
            border: 2px solid #5a5a5a;
            border-bottom: 3px solid #1a1a1a;
            color: #e0e0e0;
            font-size: 15px;
            font-weight: bold;
            cursor: pointer;
            font-family: 'Courier New', monospace;
            transition: all 0.1s ease;
            line-height: 1;
            box-shadow: 2px 2px 0 #0a0a0a;
        }

        .win-btn:hover {
            background: #4a4a4a;
            border-color: #6a9fd8;
            color: #fff;
        }

        .win-btn:active {
            transform: translateY(1px);
            box-shadow: 1px 1px 0 #0a0a0a;
        }

        /* 关闭键：红调 */
        .win-btn.close {
            background: #5a1a1a;
            border-color: #aa3333;
            color: #ff6666;
        }
        .win-btn.close:hover {
            background: #7a2a2a;
            border-color: #ff5555;
            color: #fff;
        }

        /* 全屏键：蓝调 */
        .win-btn.fullscreen {
            background: #1a3a5a;
            border-color: #3a7aaa;
            color: #6cf;
        }
        .win-btn.fullscreen:hover {
            background: #2a5a8a;
            border-color: #5a9fd8;
            color: #fff;
        }

        /* 游戏 iframe */
        .game-window iframe {
            width: 100%;
            height: 600px;
            border: none;
            display: block;
            background: #000;
        }

        /* ===== 全屏模式 ===== */
        .game-window.is-fullscreen {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            margin: 0;
            z-index: 9999;
            box-shadow: none;
            border: none;
        }

        .game-window.is-fullscreen iframe {
            height: calc(100vh - 41px);
        }

        /* ===== 版本卡片 ===== */
        .version-card {
            background: #2d2d2d;
            border: 2px solid #4a4a4a;
            border-bottom: 4px solid #1a1a1a;
            padding: 15px 18px;
            color: #e0e0e0;
            display: flex;
            flex-direction: column;
            transition: all 0.15s ease;
            font-family: 'Courier New', monospace;
            box-shadow: 4px 4px 0 #0a0a0a;
        }

        .version-card:hover {
            background: #3a3a3a;
            border-color: #6a6a6a;
            transform: translateY(-2px);
            box-shadow: 6px 6px 0 #0a0a0a;
        }

        .card-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 15px;
            margin-bottom: 25px;
        }

        /* ===== 分类标题 ===== */
        .section-title {
            color: #ffcc00;
            font-size: 20px;
            font-weight: bold;
            margin: 25px 0 12px 0;
            text-align: left;
            border-bottom: 2px solid #4a4a4a;
            padding-bottom: 6px;
            text-shadow: 2px 2px 0 #000;
            letter-spacing: 2px;
            font-family: 'Courier New', monospace;
        }

        /* ===== 卡片内文字 ===== */
        .card-title {
            font-size: 18px;
            font-weight: bold;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            color: #fff;
            text-shadow: 1px 1px 0 #000;
            margin-bottom: 4px;
        }

        .card-version {
            font-size: 12px;
            opacity: 0.7;
            font-weight: normal;
            color: #aaa;
        }

        .card-tags {
            margin: 6px 0 8px 0;
        }

        .tag {
            display: inline-block;
            background: #3a3a3a;
            padding: 2px 10px;
            font-size: 11px;
            font-weight: bold;
            margin-right: 5px;
            border: 1px solid #5a5a5a;
            color: #ccc;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .tag.recommend { background: #1a4a2a; color: #6f6; border-color: #2a7a3a; }
        .tag.beta { background: #4a3a1a; color: #fa0; border-color: #7a5a2a; }
        .tag.alpha { background: #4a1a3a; color: #f6a; border-color: #7a2a5a; }
        .tag.classic { background: #3a3a3a; color: #ccc; border-color: #5a5a5a; }
        .tag.pocket { background: #1a3a4a; color: #6cf; border-color: #2a5a7a; }

        .card-features {
            list-style: none;
            margin: 6px 0 12px;
            padding: 0;
            font-size: 13px;
            opacity: 0.85;
            line-height: 1.6;
            flex-grow: 1;
            color: #b0b0b0;
        }

        .card-features li::before {
            content: "> ";
            color: #6a9fd8;
            font-weight: bold;
        }

        /* ===== 按钮组 ===== */
        .btn-group {
            display: flex;
            gap: 8px;
            margin-top: 4px;
        }

        .btn-group .card-link {
            flex: 1;
            margin-top: 0;
        }

        .card-link {
            display: block;
            background: #3a3a3a;
            color: #e0e0e0;
            text-align: center;
            padding: 8px 0;
            font-weight: bold;
            text-decoration: none;
            border: 2px solid #5a5a5a;
            border-bottom: 3px solid #1a1a1a;
            transition: all 0.15s;
            cursor: pointer;
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-family: 'Courier New', monospace;
        }

        .card-link:hover {
            background: #4a4a4a;
            border-color: #6a9fd8;
            color: #fff;
            transform: translateY(-1px);
        }

        /* ===== 页脚 ===== */
        .footer-glass {
            background: #2d2d2d;
            border: 2px solid #4a4a4a;
            border-bottom: 4px solid #1a1a1a;
            padding: 20px 30px;
            text-align: center;
            font-size: 13px;
            margin-top: 30px;
            box-shadow: 4px 4px 0 #0a0a0a;
            font-family: 'Courier New', monospace;
        }

        .footer-black {
            color: #b0b0b0;
            font-weight: bold;
            margin-bottom: 8px;
        }

        .footer-gray {
            color: #777;
        }

        .footer-gray a {
            color: #6a9fd8;
            text-decoration: none;
            font-size: 13px;
        }

        .footer-gray a:hover {
            color: #9ac0f0;
            text-decoration: underline;
        }

        @media (max-width: 600px) {
            .card-grid { grid-template-columns: 1fr; }
            .header-bar { padding: 10px 15px; }
            .header-bar h1 { font-size: 22px; }
            .game-window iframe { height: 400px; }
            .game-window.is-fullscreen iframe { height: calc(100vh - 41px); }
            .btn-group { flex-direction: column; gap: 4px; }
            .tab-bar { flex-wrap: wrap; }
        }
    </script>
