                    <a href="https://html.cafe/xdea3c8e6" target="_blank" class="card-link">新页打开</a>
                </div>
            </div>
        </div>

        <!-- 页脚 -->
        <div class="footer-glass">
            <p class="footer-black">该网站所有minecraft资源来自eaglercraft，不提供离线版下载，如果需要请去eaglercraft.ir</p>
            <p class="footer-gray"><a href="https://space.bilibili.com/3546729704065893" target="_blank">作者b站</a></p>
        </div>
    </div>

    <script>
        /* ===== ？！玩玩？！ ===== */
        function openGame(url, name) {
            const container = document.getElementById('gameContainer');
            const iframe = document.getElementById('gameIframe');
            const title = document.getElementById('windowTitle');

            // 设置窗口标题
            title.textContent = 'YMC.JS — ' + (name || 'GAME WINDOW');

            // 显示窗口并加载
            container.style.display = 'block';
            iframe.src = url;
            container.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        /* ===== 关闭游戏 ===== */
        function closeGame() {
            const container = document.getElementById('gameContainer');
            const iframe = document.getElementById('gameIframe');

            // 退出全屏（若在）
            if (container.classList.contains('is-fullscreen')) {
                container.classList.remove('is-fullscreen');
            }

            container.style.display = 'none';
            iframe.src = '';
        }

        /* ===== 切换全屏 ===== */
        function toggleFullscreen() {
            const container = document.getElementById('gameContainer');
            container.classList.toggle('is-fullscreen');
        }

        /* ===== ESC 退出全屏 ===== */
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
                const container = document.getElementById('gameContainer');
                if (container.classList.contains('is-fullscreen')) {
                    container.classList.remove('is-fullscreen');
                }
            }
        });
    </script>
</body>
</html>